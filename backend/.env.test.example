# Copy to .env.test. Point this at a DISPOSABLE database — the suite truncates tables.
#
# A LOCAL Postgres is strongly preferred. The suite makes many small sequential queries, so a
# remote database (Neon) turns a 20-second run into a 4-minute one:
#   createdb stock_mngmt_test
#   for f in src/database/migrations/0*.sql; do psql stock_mngmt_test -f "$f"; done
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_mngmt_test
